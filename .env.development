# Local Supabase stack (npm run db:start), used by `npm run dev` and the e2e build.
# These are the Supabase CLI's fixed local defaults, the same on every machine, and the
# publishable key is browser-safe by design. To point dev at another project, put the
# values in .env.development.local (gitignored), which wins over this file. Note that
# .env.local does NOT: Vite ranks .env.[mode] above .env.local.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
