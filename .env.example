# Copy to .env.local (gitignored) and fill in from `npm run db:status`.
# Scripts and database tests read `supabase status` themselves when these are unset.

# Browser client. The publishable key is safe to ship to the browser. `npm run dev` and the
# e2e build already get the local stack's values from the committed .env.development; to
# override them in dev use .env.development.local (Vite ranks .env.[mode] above .env.local).
# Production builds (Workers Builds) read both from the committed .env.production.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Node scripts and database tests only. Bypasses RLS: never prefix with VITE_ and never commit.
SUPABASE_SECRET_KEY=
